# The template for ~/.ita-relay.env on the server. chmod 600 it.

# Both come from the Access application for your relay hostname (README, step 5).
# The relay refuses to start without them.
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=

# The Client ID of the Access service token the Ledger sends. Comma separated
# for more than one. Only the ID, never the secret.
ITA_RELAY_ALLOWED_CLIENT_IDS=

# cloudflared runs on the same server and reaches the relay here.
# Never 0.0.0.0.
ITA_RELAY_BIND_ADDR=127.0.0.1
ITA_RELAY_PORT=8788
