{
  "name": "open-ledger-il",
  "version": "1.2.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run build:web && wrangler dev",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:web:mock": "VITE_MOCK=1 vite --config web/vite.config.ts",
    "build": "npm run build:web && npm run build:worker",
    "build:web": "vite build --config web/vite.config.ts",
    "build:worker": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "npm run test:worker && npm run test:web",
    "test:worker": "vitest run --config vitest.config.ts",
    "test:web": "vitest run --config web/vitest.config.ts",
    "demo:unified-file": "node scripts/demo-unified-file.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "seed:demo": "node scripts/seed-demo.mjs",
    "leak-check": "node scripts/leak-check.mjs"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/noto-sans-hebrew": "^5.3.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.9",
    "jose": "^6.2.12",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260924.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.6.1",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "~4.1.11",
    "wrangler": "^4.140.0"
  }
}
